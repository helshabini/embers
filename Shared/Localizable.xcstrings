    "Converted at the latest rate, with no fee. Rates move, so a small difference can be the rate rather than the money.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حُوِّل بأحدث سعر، دون رسوم. الأسعار تتغير، فقد يكون فرق صغير ناتجًا عن السعر لا عن المال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum neuesten Kurs umgerechnet, ohne Gebühr. Kurse schwanken, eine kleine Differenz kann also am Kurs liegen statt am Geld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertido al tipo más reciente, sin comisión. Los tipos cambian, así que una pequeña diferencia puede deberse al tipo y no al dinero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Converti au dernier taux, sans frais. Les taux bougent : un petit écart peut venir du taux plutôt que de l’argent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新のレートで手数料なしで換算しています。レートは変動するため、小さな差額はお金ではなくレートによるものかもしれません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertido pela cotação mais recente, sem tarifa. As cotações mudam, então uma pequena diferença pode ser da cotação e não do dinheiro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按最新汇率换算，不含手续费。汇率会变动，所以小额差额可能来自汇率而非资金。"
          }
        }
      }
    },
