        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei der Bank liegen %@ weniger, als die App annimmt. Beim Abgleichen wird eine Korrektur über die Differenz gebucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El banco tiene %@ menos de lo que cree la app. Al conciliar se registra un ajuste por la diferencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La banque indique %@ de moins que l’app. Le rapprochement enregistre un ajustement de l’écart."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行の残高がアプリより%@少なくなっています。照合すると、差額の調整取引を1件記録します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O banco tem %@ a menos do que o app calcula. Ao conciliar, um ajuste com a diferença é lançado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
