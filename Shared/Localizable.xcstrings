    "Their day has come, but none of them counts until you approve it. Skip one if the payment never went out.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حلّ موعدها، لكن لا تُحتسب أيٌّ منها حتى تعتمدها. تخطَّ ما لم تُدفع فعلًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Tag ist gekommen, aber keine davon zählt, bevor du sie bestätigst. Überspring eine, wenn die Zahlung nie rausging."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya llegó su fecha, pero ninguna cuenta hasta que la apruebes. Omite una si el pago nunca salió."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Leur date est arrivée, mais aucune ne compte tant que vous ne l’avez pas approuvée. Sautez-en une si le paiement n’a jamais eu lieu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定日を迎えましたが、承認するまでどれも反映されません。支払いが行われなかったものはスキップしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A data delas chegou, mas nenhuma conta até você aprovar. Pule uma se o pagamento nunca saiu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些交易的日期已到，但在你批准之前都不会计入。如果某笔付款并未发生，就跳过它。"
          }
        }
      }
    },
    "Theme": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السمة"
          }
        },
        "de": {
