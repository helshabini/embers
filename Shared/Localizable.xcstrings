    "In %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In %@."
          }
        },
        "es": {
          "stringUnit": {
