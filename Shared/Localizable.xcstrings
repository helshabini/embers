    "You spend about %@ a month more than you make.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصرف نحو %@ شهريًا أكثر مما تكسب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du gibst etwa %@ im Monat mehr aus, als du einnimmst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gastas unos %@ al mes más de lo que ganas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous dépensez environ %@ de plus par mois que vous ne gagnez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎月、収入より約%@多く支出しています。"
