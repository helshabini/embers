    "Money here is budgeted: it counts towards Ready to Assign.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأموال هنا ضمن الميزانية: تُحسب في «متاح للتوزيع»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geld hier ist im Budget: Es zählt zu „Zu verteilen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dinero de aquí está presupuestado: cuenta para Listo para asignar."
          }
        },
        "fr": {
          "stringUnit": {
