    "Scheduled for later this month: %@. Assigning it now means the money is waiting when it comes due.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مُجدول لاحقًا هذا الشهر: %@. إن خصصته الآن فسيكون المال جاهزًا عند الاستحقاق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Später in diesem Monat geplant: %@. Weist du es jetzt zu, liegt das Geld bereit, wenn es fällig wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Programado para más adelante este mes: %@. Si lo asignas ahora, el dinero estará listo cuando venza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prévu plus tard ce mois-ci : %@. En l’allouant maintenant, l’argent sera là à l’échéance."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月この後の予定：%@。今割り当てておけば、期日にお金が用意されています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agendado para mais tarde neste mês: %@. Distribuindo agora, o dinheiro estará pronto no vencimento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
