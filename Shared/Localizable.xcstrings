    "Paying in %@ from this account is a domestic charge. Anything else attracts the bank's FX fee.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الدفع بـ %@ من هذا الحساب معاملة محلية، وأي عملة أخرى تُطبَّق عليها رسوم الصرف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlungen in %@ von diesem Konto sind Inlandszahlungen. Für alles andere fällt die Fremdwährungsgebühr der Bank an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagar en %@ desde esta cuenta es un cargo nacional. Cualquier otra moneda conlleva la comisión por divisa del banco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Payer en %@ depuis ce compte n’entraîne pas de frais de change. Toute autre devise est soumise aux frais de change de la banque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この口座から%@で支払う場合は国内取引です。それ以外の通貨では銀行の為替手数料がかかります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagar em %@ com esta conta é uma compra nacional. Qualquer outra moeda paga a tarifa de câmbio do banco."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用此账户支付 %@ 属于本币交易，支付其他币种会收取银行的货币转换费。"
          }
        }
      }
    },
    "Paying in %@ from this account is a domestic charge. Paying in anything else attracts the fee below.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الدفع بـ %@ من هذا الحساب معاملة محلية، والدفع بأي عملة أخرى تُطبَّق عليه الرسوم أدناه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlungen in %@ von diesem Konto sind Inlandszahlungen. Für Zahlungen in anderen Währungen fällt die Gebühr unten an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagar en %@ desde esta cuenta es un cargo nacional. Pagar en cualquier otra moneda conlleva la comisión de abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Payer en %@ depuis ce compte n’entraîne pas de frais de change. Payer dans une autre devise entraîne les frais ci-dessous."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この口座から%@で支払う場合は国内取引です。それ以外の通貨では下記の手数料がかかります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagar em %@ com esta conta é uma compra nacional. Pagar em qualquer outra moeda gera a tarifa abaixo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用此账户支付 %@ 属于本币交易，支付其他币种会收取以下手续费。"
          }
        }
      }
    },
    "Payments": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المدفوعات"
          }
        },
        "de": {
          "stringUnit": {
