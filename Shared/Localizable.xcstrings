            "value": "En %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将添加到“%@”。"
          }
        }
      }
    },
    "In YNAB, open your budget's settings and choose Export Budget. Pick the .zip file it gives you — nothing is imported until you review it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في YNAB، افتح إعدادات ميزانيتك واختر Export Budget. اختر ملف ‎.zip الناتج — لن يُستورد شيء قبل أن تراجعه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne in YNAB die Einstellungen deines Budgets und wähle „Export Budget“. Wähle die .zip-Datei, die du erhältst – importiert wird erst, wenn du alles geprüft hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En YNAB, abre los ajustes de tu presupuesto y elige Exportar presupuesto (Export Budget). Selecciona el archivo .zip que te da: no se importa nada hasta que lo revises."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans YNAB, ouvrez les réglages de votre budget et choisissez « Export Budget ». Sélectionnez le fichier .zip obtenu : rien n’est importé avant que vous l’ayez vérifié."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "YNABで予算の設定を開き、「Export Budget」を選んでください。作成された.zipファイルを選択します。内容を確認するまで、何も読み込まれません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No YNAB, abra os ajustes do seu orçamento e escolha Export Budget. Selecione o arquivo .zip gerado — nada é importado antes de você revisar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 YNAB 中打开预算设置，选择 Export Budget，然后选取生成的 .zip 文件。确认之前不会导入任何内容。"
          }
        }
      }
    },
    "In against out": {
