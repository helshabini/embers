    "You spent about as much as you made.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صرفت قدر ما كسبت تقريبًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast etwa so viel ausgegeben, wie du eingenommen hast."
          }
        },
        "es": {
          "stringUnit": {
