    },
    "Transfers are paired, the credit card categories match your accounts, and every transfer across the edge of the budget says where it belongs.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التحويلات مكتملة الطرفين، وبنود بطاقات الائتمان تطابق حساباتك، وكل تحويل يعبر حدود الميزانية محدد بنده."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umbuchungen sind vollständig, die Kreditkarten-Kategorien passen zu deinen Konten, und jede Umbuchung über die Budgetgrenze hat ihre Kategorie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las transferencias están emparejadas, las categorías de tarjetas de crédito coinciden con tus cuentas y cada transferencia que cruza el límite del presupuesto indica a dónde pertenece."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les virements ont leurs deux côtés, les catégories des cartes de crédit correspondent à vos comptes et chaque virement qui entre dans le budget ou en sort a sa catégorie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "振替はすべて対になっており、クレジットカードのカテゴリは口座と一致し、予算の内外をまたぐ振替にはすべてカテゴリが設定されています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As transferências têm os dois lados, as categorias de cartão batem com suas contas e toda transferência que cruza o orçamento tem categoria."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转账两端齐全，信用卡类别与账户一致，每笔进出预算的转账都已指定类别。"
          }
        }
      }
    },
    "Transfers lose both sides, and splits all their lines.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحذف التحويلات بطرفيها، والمعاملات المقسّمة بكل بنودها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umbuchungen verlieren beide Seiten, aufgeteilte Buchungen alle ihre Zeilen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las transferencias pierden ambos lados, y las divididas todas sus líneas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les virements perdent leurs deux côtés, et les ventilations toutes leurs lignes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "振替は両側が、分割取引はすべての明細行が削除されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transferências perdem os dois lados, e transações divididas todas as linhas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转账的两边都会删除，拆分交易的所有明细也会删除。"
          }
        }
      }
    },
    "Transfers missing their other half": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحويلات ينقصها طرفها الآخر"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
