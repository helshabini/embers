    "A few of YNAB's internal credit-card movements can't be recalculated from the register. Matching records the difference as an adjustment so your starting balances agree with YNAB exactly.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعض حركات بطاقات الائتمان الداخلية في YNAB لا يمكن حسابها من السجل. المطابقة تسجّل الفرق كتسوية، فتبدأ أرصدتك متطابقة تمامًا مع YNAB."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige interne Kreditkartenbewegungen von YNAB lassen sich aus den Buchungen nicht nachrechnen. Beim Angleichen wird die Differenz als Korrektur erfasst, damit deine Anfangssalden genau mit YNAB übereinstimmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos movimientos internos de tarjetas de crédito de YNAB no se pueden recalcular a partir del registro. Al igualarlos, la diferencia se anota como un ajuste para que tus saldos iniciales coincidan exactamente con YNAB."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains mouvements internes de YNAB liés aux cartes de crédit ne peuvent pas être recalculés à partir du registre. L’alignement enregistre l’écart comme un ajustement, pour que vos soldes de départ correspondent exactement à ceux de YNAB."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "YNAB内部のクレジットカード関連の動きの一部は、取引履歴から再計算できません。合わせると差額を調整として記録し、開始時の残高がYNABと完全に一致します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas movimentações internas de cartão de crédito do YNAB não podem ser recalculadas a partir do registro. Igualar lança a diferença como um ajuste, para que seus saldos iniciais batam exatamente com o YNAB."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "YNAB 内部的少量信用卡资金变动无法从账目明细中重新算出。对齐会把差额记为一笔调整，让你的期初余额与 YNAB 完全一致。"
          }
        }
      }
    },
    "A few quiet days": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بضعة أيام بلا تسجيل"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein paar ruhige Tage"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unos días sin movimientos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelques jours sans saisie"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録のない日が続いたとき"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns dias sem lançamentos"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "几天没有记账"
          }
        }
      }
    },
    "A tracking account counts towards net worth only. Nothing here is budgeted.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حساب المتابعة يُحسب في صافي الثروة فقط، ولا يدخل شيء منه في الميزانية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tracking-Konto zählt nur zum Vermögen. Nichts davon wird budgetiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cuenta de seguimiento solo cuenta para tu patrimonio neto. Nada de lo que contiene entra en el presupuesto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compte de suivi compte uniquement dans le patrimoine net. Rien n’y est budgété."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録用口座は純資産にのみ反映され、予算には含まれません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma conta de acompanhamento entra só no patrimônio líquido. Nada aqui faz parte do orçamento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟踪账户只计入净资产，其中的钱不纳入预算。"
          }
        }
      }
    },
    "A transaction for %@ will be added so this account matches the statement.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُضاف معاملة بقيمة %@ ليطابق الحساب كشف البنك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Buchung über %@ wird hinzugefügt, damit dieses Konto zum Kontoauszug passt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se añadirá una transacción de %@ para que esta cuenta coincida con el extracto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une opération de %@ sera ajoutée pour que ce compte corresponde au relevé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この口座を明細に合わせるため、%@の取引を追加します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma transação de %@ será adicionada para que esta conta bata com o extrato."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将添加一笔 %@ 的交易，使该账户与对账单一致。"
          }
        }
      }
    },
