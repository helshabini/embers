          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvar um backup…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存备份…"
          }
        }
      }
    },
    "Saves a backup first, then clears every account, category and transaction — on every device signed in to your Apple Account. To fix only this device's copy, use Download Again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ نسخة احتياطية أولًا، ثم يُمسح كل حساب وبند ومعاملة — على كل جهاز مسجّل بحساب Apple الخاص بك. لإصلاح نسخة هذا الجهاز وحده، استخدم «تنزيل من جديد»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichert zuerst ein Backup und löscht dann alle Konten, Kategorien und Buchungen – auf allen Geräten mit deinem Apple Account. Um nur die Kopie auf diesem Gerät zu reparieren, nutze „Erneut laden“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero guarda una copia de seguridad y luego elimina todas las cuentas, categorías y transacciones, en todos los dispositivos con tu cuenta de Apple. Para arreglar solo la copia de este dispositivo, usa Descargar de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre d’abord une sauvegarde, puis efface tous les comptes, catégories et opérations — sur tous les appareils connectés à votre compte Apple. Pour ne réparer que la copie de cet appareil, utilisez Télécharger à nouveau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先にバックアップを保存してから、すべての口座・カテゴリ・取引を削除します。同じApple Accountでサインインしているすべてのデバイスが対象です。このデバイスのコピーだけを直すには「再ダウンロード」を使ってください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva um backup primeiro e depois apaga todas as contas, categorias e transações — em todos os aparelhos com a sua Conta Apple. Para corrigir só a cópia deste aparelho, use Baixar de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先保存一份备份，然后清除所有账户、类别和交易——在所有登录你 Apple 账户的设备上。若只想修复这台设备的副本，请使用“重新下载”。"
          }
        }
      }
    },
    "Saves a backup first, then clears every account, category and transaction.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ نسخة احتياطية أولًا، ثم يمسح كل الحسابات والبنود والمعاملات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichert zuerst ein Backup und löscht dann alle Konten, Kategorien und Buchungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero guarda una copia de seguridad y después borra todas las cuentas, categorías y transacciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre d’abord une sauvegarde, puis efface tous les comptes, catégories et opérations."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずバックアップを保存し、その後すべての口座・カテゴリ・取引を消去します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva um backup primeiro e depois apaga todas as contas, categorias e transações."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先保存一份备份，然后清空所有账户、类别和交易。"
          }
        }
      }
    },
