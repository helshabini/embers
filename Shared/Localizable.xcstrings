    "Overspent. Next month pays for it unless you cover it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجاوز الإنفاق. سيتحمّله الشهر القادم ما لم تغطِّه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überzogen. Der nächste Monat zahlt dafür, wenn du es nicht ausgleichst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gasto excedido. Lo paga el mes siguiente si no lo cubres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dépassement. Le mois suivant le paiera si vous ne le couvrez pas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使いすぎです。補填しないと翌月の負担になります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gasto acima do disponível. O próximo mês paga por isso, a menos que você cubra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已超支。若不补足，将由下个月承担。"
          }
        }
      }
    },
