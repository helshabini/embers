            "state": "translated",
            "value": "Ahorras unos %@ al mes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous mettez de côté environ %@ par mois."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
