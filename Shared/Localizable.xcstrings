    "Everything is recorded in this currency, whatever you type it in.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُسجَّل كل شيء بهذه العملة، أيًّا كانت العملة التي تُدخل بها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles wird in dieser Währung erfasst, egal in welcher du es eingibst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo se registra en esta moneda, sea cual sea la que uses al escribir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est enregistré dans cette devise, quelle que soit celle de la saisie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの通貨で入力しても、この通貨で記録されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo é registrado nesta moeda, seja qual for a moeda em que você digitar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无论你用哪种币种输入，都会以此币种记账。"
          }
        }
      }
    },
