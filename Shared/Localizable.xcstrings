    "Categories taken off the plan. Everything they hold is still counted in the months it happened.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بنود أُخرجت من الخطة. كل ما فيها يبقى محسوبًا في الأشهر التي حدث فيها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus dem Plan genommene Kategorien. Alles, was sie enthalten, zählt weiter in den Monaten, in denen es geschah."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Categorías retiradas del plan. Todo lo que contienen sigue contando en los meses en que ocurrió."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Catégories retirées du plan. Tout ce qu’elles contiennent reste compté dans les mois concernés."
          }
