    "Scheduled to repeat. When %@ arrives it waits for you to approve it, and approving it schedules the one after.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجدولة للتكرار. حين يحلّ %@ تنتظر اعتمادك، واعتمادها يُجدوِل التالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederkehrend geplant. Am %@ wartet sie auf deine Bestätigung, und erst die Bestätigung plant die nächste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Programada para repetirse. Cuando llegue el %@, esperará a que la apruebes, y al aprobarla se programará la siguiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Opération récurrente. Le %@, elle attendra votre approbation, et l’approuver planifiera la suivante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "繰り返しの予定です。%@になると承認待ちになり、承認すると次回分が予定されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agendada para repetir. Quando chegar %@, ela aguarda sua aprovação, e aprová-la agenda a próxima."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已设为重复。到 %@ 时会等待你批准，批准后自动安排下一笔。"
          }
        }
      }
    },
