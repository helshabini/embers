    "An adjustment of %@ is written, so the account reads zero and can be closed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُسجَّل تسوية بقيمة %@ ليصبح رصيد الحساب صفرًا ويمكن إغلاقه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird eine Anpassung über %@ gebucht, damit das Konto auf null steht und geschlossen werden kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se registra un ajuste de %@ para que la cuenta quede en cero y pueda cerrarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ajustement de %@ est enregistré : le compte affiche zéro et peut être clôturé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の調整が記録され、口座残高がゼロになって解約できるようになります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um ajuste de %@ é registrado para que a conta fique zerada e possa ser encerrada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将记录一笔 %@ 的调整，使账户余额为零，然后即可关闭。"
          }
        }
      }
    },
