    "The bank holds %@ less than the app thinks. Reconciling writes one adjustment for the difference against Ready to Assign.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رصيد البنك أقل بـ %@ مما يظنه التطبيق. ستُسجَّل تسوية واحدة بالفرق على «متاح للتوزيع»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei der Bank liegen %@ weniger, als die App annimmt. Beim Abgleichen wird eine Korrektur über die Differenz zulasten von „Zu verteilen“ gebucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El banco tiene %@ menos de lo que cree la app. Al conciliar se registra un ajuste por la diferencia contra Listo para asignar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La banque indique %@ de moins que l’app. Le rapprochement enregistre un ajustement de l’écart sur « À allouer »."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行の残高がアプリより%@少なくなっています。照合すると、差額を割り当て可能額から調整する取引を1件記録します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O banco tem %@ a menos do que o app calcula. Ao conciliar, um ajuste com a diferença é lançado em Pronto para distribuir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "银行余额比 App 记录的少 %@。对账时会记一笔差额调整，计入“待分配”。"
          }
        }
      }
    },
    "The bank holds %@ less than the app thinks. Reconciling writes one adjustment for the difference.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رصيد البنك أقل بـ %@ مما يظنه التطبيق. ستُسجَّل تسوية واحدة بالفرق."
