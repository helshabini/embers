    "Changes what the type would do by default. Most accounts want the default.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يغيّر ما يفعله نوع الحساب افتراضيًا. معظم الحسابات تناسبها القيمة الافتراضية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändert, was der Kontotyp standardmäßig tun würde. Für die meisten Konten passt der Standard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia lo que el tipo haría de forma predeterminada. A la mayoría de las cuentas les conviene el valor predeterminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifie le comportement par défaut du type. La plupart des comptes s’en tiennent au réglage par défaut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "口座の種類による既定の動作を変更します。ほとんどの口座は既定のままで問題ありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muda o que o tipo faria por padrão. Na maioria das contas, o padrão é o melhor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改该账户类型的默认处理方式。大多数账户保持默认即可。"
          }
        }
      }
    },
