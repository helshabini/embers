    "In the evening: reconcile and look over the plan.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مساءً: طابِق حساباتك وراجع الخطة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Abend: Konten abgleichen und den Plan durchsehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por la noche: concilia tus cuentas y revisa el plan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le soir : rapprochez vos comptes et relisez le plan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夕方に：口座を照合し、プランを見直します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "À noite: concilie suas contas e revise o plano."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "晚上：对账并查看计划。"
          }
        }
      }
    },
