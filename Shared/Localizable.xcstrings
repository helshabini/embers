    "Creates two entries: one leaving this account and one arriving in the other.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُنشأ معاملتان: واحدة تخرج من هذا الحساب وأخرى تدخل الحساب الآخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellt zwei Buchungen: eine, die dieses Konto verlässt, und eine, die im anderen ankommt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea dos movimientos: uno que sale de esta cuenta y otro que llega a la otra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée deux opérations : une qui sort de ce compte et une qui arrive sur l’autre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この口座からの出金と、相手口座への入金の2件を作成します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cria dois lançamentos: um saindo desta conta e outro entrando na outra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会生成两笔记录：一笔从本账户转出，一笔转入另一个账户。"
          }
        }
      }
    },
