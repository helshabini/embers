    "On average you spend about as much as you make.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في المتوسط تصرف قدر ما تكسب تقريبًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Schnitt gibst du etwa so viel aus, wie du einnimmst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De media gastas más o menos lo mismo que ganas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En moyenne, vous dépensez à peu près autant que vous gagnez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "平均すると、収入とほぼ同じだけ支出しています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em média, você gasta mais ou menos o que ganha."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平均来看，你的支出与收入基本持平。"
          }
        }
      }
    },
