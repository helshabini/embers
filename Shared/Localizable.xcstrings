    "Transactions are still to come in this account. Delete them or move them to another account before closing it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تزال في هذا الحساب معاملات قادمة. احذفها أو انقلها إلى حساب آخر قبل إغلاقه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Konto stehen noch künftige Buchungen an. Lösche sie oder verschiebe sie auf ein anderes Konto, bevor du es schließt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún hay movimientos por venir en esta cuenta. Elimínalos o muévelos a otra cuenta antes de cerrarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des opérations sont encore à venir sur ce compte. Supprimez-les ou déplacez-les vers un autre compte avant de le clôturer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この口座にはまだ予定の取引があります。解約する前に削除するか、別の口座へ移してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda há transações por vir nesta conta. Exclua-as ou mova-as para outra conta antes de encerrá-la."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户还有待发生的交易。关闭前请删除它们或移到其他账户。"
          }
        }
      }
    },
