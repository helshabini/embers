    "Some transactions here have not cleared. Clear or delete them before closing the account.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعض المعاملات هنا لم تُقيَّد بعد. قيِّدها أو احذفها قبل إغلاق الحساب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Buchungen hier sind noch nicht gebucht. Bestätige oder lösche sie, bevor du das Konto schließt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos movimientos aquí no están confirmados. Confírmalos o elimínalos antes de cerrar la cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines opérations ici ne sont pas encore pointées. Pointez-les ou supprimez-les avant de clôturer le compte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未確定の取引があります。口座を解約する前に、確定するか削除してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas transações aqui não foram compensadas. Compense-as ou exclua-as antes de encerrar a conta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里有些交易尚未入账。关闭账户前请先确认入账或删除它们。"
          }
        }
      }
    },
