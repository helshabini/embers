    "Import a YNAB export, or add an account to get started.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استورد ملفًا من YNAB، أو أضف حسابًا لتبدأ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importiere einen YNAB-Export oder füge ein Konto hinzu, um loszulegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa una exportación de YNAB, o añade una cuenta para empezar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez un export YNAB, ou ajoutez un compte pour commencer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "YNABのエクスポートを読み込むか、口座を追加して始めましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe uma exportação do YNAB ou adicione uma conta para começar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入 YNAB 导出文件，或添加账户即可开始。"
          }
        }
      }
    },
