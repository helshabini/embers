    "Reminders are worked out on this device from your plan, and come whether or not Embers is open.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحسب التذكيرات على هذا الجهاز من خطتك، وتصل سواء كان Embers مفتوحًا أم لا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen werden auf diesem Gerät aus deinem Plan berechnet und kommen, ob Embers geöffnet ist oder nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios se calculan en este dispositivo a partir de tu plan y llegan esté Embers abierto o no."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels sont calculés sur cet appareil à partir de votre plan, et arrivent qu'Embers soit ouvert ou non."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーはこのデバイス上でプランから作られ、Embersを開いていなくても届きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os lembretes são calculados neste aparelho a partir do seu plano e chegam com o Embers aberto ou não."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒在此设备上根据你的计划生成，无论 Embers 是否打开都会送达。"
          }
        }
      }
    },
