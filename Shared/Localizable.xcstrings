    "Finds anything the plan cannot settle on its own.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجد ما لا تستطيع الخطة حسمه وحدها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Findet alles, was der Plan nicht selbst klären kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra lo que el plan no puede resolver por sí solo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repère tout ce que le plan ne peut pas régler seul."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プランだけでは解決できない点を見つけます。"
          }
        },
        "pt-BR": {
