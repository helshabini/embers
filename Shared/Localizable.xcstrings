    },
    "%@ iCloud tries again by itself.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ سيعيد iCloud المحاولة تلقائيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ iCloud versucht es von selbst erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ iCloud lo vuelve a intentar por sí solo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ iCloud réessaiera de lui-même."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ iCloudが自動的に再試行します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ O iCloud tenta de novo sozinho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ iCloud 会自动重试。"
          }
        }
      }
    },
    "%@ more needed": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلزم %@ إضافية"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch %@ nötig"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltan %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Encore %@ nécessaires"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あと%@必要"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltam %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还需 %@"
          }
        }
      }
    },
    "%@ will be removed from all your devices, not only this one. A backup is saved to Files first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحذف %@ من كل أجهزتك، لا من هذا الجهاز وحده. تُحفظ نسخة احتياطية في «الملفات» أولًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird von allen deinen Geräten entfernt, nicht nur von diesem. Vorher wird ein Backup in „Dateien“ gesichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminará %@ de todos tus dispositivos, no solo de este. Antes se guarda una copia de seguridad en Archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ seront supprimés de tous vos appareils, pas seulement de celui-ci. Une sauvegarde est d’abord enregistrée dans Fichiers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスだけでなく、すべてのデバイスから%@を削除します。先に「ファイル」へバックアップを保存します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto remove %@ de todos os seus aparelhos, não só deste. Antes, um backup é salvo em Arquivos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将从你的所有设备上删除%@，而不只是这台设备。删除前会先在“文件”中保存一份备份。"
          }
        }
      }
    },
    "%@ will be removed. A backup is saved to Files first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحذف %@. تُحفظ نسخة احتياطية في «الملفات» أولًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird entfernt. Vorher wird ein Backup in „Dateien“ gesichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminará %@. Antes se guarda una copia de seguridad en Archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ seront supprimés. Une sauvegarde est d’abord enregistrée dans Fichiers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を削除します。先に「ファイル」へバックアップを保存します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto remove %@. Antes, um backup é salvo em Arquivos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将删除%@。删除前会先在“文件”中保存一份备份。"
          }
        }
      }
    },
