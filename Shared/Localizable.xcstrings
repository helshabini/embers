    "%@, saved %@. This replaces everything currently in the app, on all your devices.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@، محفوظة في %@. ستحلّ محلّ كل ما في التطبيق الآن، على كل أجهزتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, gesichert am %@. Das ersetzt alles, was gerade in der App ist – auf allen deinen Geräten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@, saved %2$@. This replaces everything currently in the app, on all your devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, guardada el %@. Reemplazará todo lo que hay ahora en la app, en todos tus dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, sauvegarde du %@. Elle remplacera tout ce que contient l’app, sur tous vos appareils."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（%@に保存）。すべてのデバイスで、現在アプリにあるデータがすべて置き換えられます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, salvo em %@. Isso substitui tudo o que está no app agora, em todos os seus aparelhos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，保存于%2$@。这会替换你所有设备上 App 中现有的全部内容。"
          }
        }
      }
    },
