    "What the account holds today, in %@. Leave it empty for zero.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما في الحساب اليوم بـ %@. اتركه فارغًا إن كان صفرًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was heute auf dem Konto ist, in %@. Leer lassen für null."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que tiene hoy la cuenta, en %@. Déjalo vacío si es cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le solde actuel du compte, en %@. Laissez vide pour zéro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の口座残高（%@）。ゼロの場合は空欄のままにしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto há na conta hoje, em %@. Deixe em branco se for zero."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户当前余额（%@）。为零可留空。"
          }
        }
      }
    },
    "What the app believes has reached the bank. Anything still uncleared is left out, because the statement has not seen it either.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما يعتقد التطبيق أنه وصل البنك. ما لم يُقيَّد بعد مستبعد، لأن الكشف لم يره أيضًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was laut App bereits bei der Bank angekommen ist. Vorgemerkte Buchungen fehlen, weil auch der Kontoauszug sie noch nicht kennt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que la app cree que ya llegó al banco. Lo que sigue sin confirmar se deja fuera, porque el extracto tampoco lo refleja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que l’app considère comme passé en banque. Les opérations non pointées sont exclues, car le relevé ne les connaît pas non plus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行に反映済みとアプリが判断している金額です。未確定の取引は明細にもまだ載っていないため、含めていません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que o app entende que já chegou ao banco. O que ainda não foi compensado fica de fora, porque também não aparece no extrato."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 认为银行已入账的金额。未入账的交易不计入，因为对账单上也还没有。"
          }
        }
      }
    },
    "What you owe today, as a positive number. Leave it empty if nothing is owed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما عليك اليوم، كرقم موجب. اتركه فارغًا إن لم يكن عليك شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du heute schuldest, als positive Zahl. Leer lassen, wenn nichts offen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que debes hoy, como número positivo. Déjalo vacío si no debes nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous devez aujourd’hui, en nombre positif. Laissez vide si vous ne devez rien."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の支払残高（正の数で入力）。残高がない場合は空欄のままにしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto você deve hoje, como número positivo. Deixe em branco se não deve nada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前欠款，填正数。没有欠款可留空。"
          }
        }
      }
    },
    "When no backup has been saved on this device for a month.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن لم تُحفظ نسخة احتياطية على هذا الجهاز منذ شهر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn auf diesem Gerät seit einem Monat kein Backup gesichert wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no se ha guardado una copia de seguridad en este dispositivo en un mes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si aucune sauvegarde n'a été enregistrée sur cet appareil depuis un mois."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスで1か月バックアップを保存していない場合。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se nenhum backup tiver sido salvo neste aparelho em um mês."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当此设备一个月内没有保存备份时。"
          }
        }
      }
    },
    "When nothing has been entered for three days.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن لم يُسجَّل شيء منذ ثلاثة أيام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn drei Tage lang nichts eingetragen wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no se ha registrado nada en tres días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si rien n'a été saisi depuis trois jours."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3日間何も記録していない場合。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se nada tiver sido lançado em três dias."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当三天没有记录任何内容时。"
