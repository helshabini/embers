    "Close Embers and open it again. Your budget then comes down from iCloud as it would on a new device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أغلق Embers وافتحه من جديد. ستُجلب ميزانيتك من iCloud كما يحدث على جهاز جديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe Embers und öffne es erneut. Dein Budget wird dann wie auf einem neuen Gerät aus iCloud geladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra Embers y vuelve a abrirlo. Tu presupuesto llegará desde iCloud como en un dispositivo nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermez Embers et rouvrez-le. Votre budget sera alors récupéré depuis iCloud comme sur un nouvel appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Embersを閉じてもう一度開いてください。新しいデバイスと同じように、iCloudから予算を取得します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Feche o Embers e abra de novo. Seu orçamento então vem do iCloud como em um aparelho novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请关闭 Embers 后重新打开。你的预算会像在新设备上一样从 iCloud 获取。"
          }
        }
      }
    },
