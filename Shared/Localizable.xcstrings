            "value": "取引を書き込み中…しばらくお待ちください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravando suas transações… pode levar um instante."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在写入交易…可能需要一点时间。"
          }
        }
      }
    },
    "You assigned more than you have": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خصصت أكثر مما لديك"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast mehr verteilt, als du hast"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asignaste más de lo que tienes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez alloué plus que vous n’avez"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手持ちより多く割り当てています"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você distribuiu mais do que tem"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你分配的钱比你拥有的多"
          }
        }
      }
    },
    "You keep about %@ a month.": {
      "localizations": {
