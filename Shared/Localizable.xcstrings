    "Nothing has been assigned or spent here, so nothing is lost.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُخصَّص أو يُصرف شيء هنا، فلن يضيع شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier wurde nichts zugewiesen oder ausgegeben, also geht nichts verloren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí no se ha asignado ni gastado nada, así que no se pierde nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’a été alloué ni dépensé ici, donc rien n’est perdu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "割り当ても支出もないため、失われるものはありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada foi distribuído ou gasto aqui, então nada se perde."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里没有分配或支出过任何钱，删除不会丢失数据。"
          }
        }
      }
    },
