      }
    },
    "The bank holds %@ more than the app thinks. Reconciling writes one adjustment for the difference against Ready to Assign.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رصيد البنك أكثر بـ %@ مما يظنه التطبيق. ستُسجَّل تسوية واحدة بالفرق على «متاح للتوزيع»."
          }
        },
        "de": {
          "stringUnit": {
