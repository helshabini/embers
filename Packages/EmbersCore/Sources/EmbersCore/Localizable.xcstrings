    "Entries over a month old, not yet checked against a statement: %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معاملات مضى عليها أكثر من شهر ولم تُطابَق مع كشف: %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Buchungen älter als einen Monat, noch nicht mit einem Kontoauszug abgeglichen: %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Movimientos de hace más de un mes sin comprobar con un extracto: %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Opérations de plus d'un mois, pas encore vérifiées sur un relevé : %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1か月以上前の取引で、まだ明細と照合していないもの：%@。"
