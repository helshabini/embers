    "Nothing has been entered for a few days. A minute now keeps the plan true.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُسجَّل شيء منذ بضعة أيام. دقيقة الآن تُبقي الخطة صادقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seit ein paar Tagen wurde nichts eingetragen. Eine Minute jetzt hält den Plan aktuell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha registrado nada en unos días. Un minuto ahora mantiene el plan al día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'a été saisi depuis quelques jours. Une minute maintenant garde le plan juste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数日間何も記録されていません。今の1分でプランを正確に保てます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada foi lançado nos últimos dias. Um minuto agora mantém o plano fiel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "几天没有记录了。现在花一分钟，让计划保持准确。"
          }
        }
      }
    },
