    "No backup has been saved on this device for over a month. A copy in Files is one you can always go back to.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُحفظ نسخة احتياطية على هذا الجهاز منذ أكثر من شهر. نسخة في «الملفات» يمكنك الرجوع إليها دائمًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät wurde seit über einem Monat kein Backup gesichert. Eine Kopie in „Dateien“ kannst du immer zurückholen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha guardado una copia de seguridad en este dispositivo en más de un mes. Una copia en Archivos es algo a lo que siempre puedes volver."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune sauvegarde n'a été enregistrée sur cet appareil depuis plus d'un mois. Une copie dans Fichiers est une copie à laquelle vous pourrez toujours revenir."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスでは1か月以上バックアップが保存されていません。「ファイル」のコピーにはいつでも戻れます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum backup foi salvo neste aparelho há mais de um mês. Uma cópia em Arquivos é uma a que você sempre pode voltar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备已超过一个月没有保存备份。存在“文件”中的副本随时可以恢复。"
          }
        }
      }
    },
    "No exchange rates are available yet.": {
