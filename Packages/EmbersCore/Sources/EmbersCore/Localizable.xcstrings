{
  "sourceLanguage": "en",
  "strings": {
    "%@ has begun": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدأ شهر %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat begonnen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comenzó %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nouveau mois (%@)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@になりました"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ começou"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@开始了"
          }
        }
      }
    },
    "%@ is not valid UTF-8 text.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الملف %@ ليس نصًا صالحًا بترميز UTF-8."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist kein gültiger UTF-8-Text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no es texto UTF-8 válido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’est pas un texte UTF-8 valide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は有効なUTF-8テキストではありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não é um texto UTF-8 válido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不是有效的 UTF-8 文本。"
          }
        }
      }
    },
    "%@ is short": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ لا يكفي"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ reicht nicht"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A %@ le falta dinero"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ : il manque de l'argent"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が不足しています"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta dinheiro em %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@余额不足"
          }
        }
      }
    },
    "%@ more is needed for what is due on %@. Assign it before then.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلزم %1$@ إضافية لما يستحق في %2$@. خصّصها قبل ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es fehlen noch %1$@ für das, was am %2$@ fällig ist. Weise es vorher zu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ more is needed for what is due on %2$@. Assign it before then."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltan %1$@ para lo que vence el %2$@. Asígnalo antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il manque %1$@ pour ce qui arrive à échéance le %2$@. Allouez-le avant."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@が期日の支払いに、あと%1$@必要です。それまでに割り当ててください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltam %1$@ para o que vence em %2$@. Distribua antes disso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@到期的款项还差%1$@。请在此之前分配。"
          }
        }
      }
    },
    "%@. Approve it once it has gone out, or skip it if it has not.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. اعتمدها بعد أن تُدفع، أو تخطَّها إن لم تُدفع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Bestätige sie, sobald sie abgegangen ist, oder überspringe sie, falls nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Apruébalo cuando se haya pagado, u omítelo si no."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Approuvez-la une fois payée, ou sautez-la si elle ne l'a pas été."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。支払われたら承認し、支払われなければスキップしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Aprove depois que for pago, ou pule se não foi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。付款完成后请批准，未付款则跳过。"
          }
        }
      }
    },
    "%@. Pay now and the transfer has time to arrive.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. ادفع الآن ليتسع الوقت لوصول التحويل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Zahl jetzt, dann hat die Überweisung Zeit anzukommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Paga ahora para que la transferencia llegue a tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Payez maintenant pour laisser au virement le temps d'arriver."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。今払えば振込が間に合います。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Pague agora para a transferência ter tempo de chegar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。现在还款，转账有时间到账。"
          }
        }
      }
    },
    "About 160 currencies, updated daily.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نحو 160 عملة، تُحدَّث يوميًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rund 160 Währungen, täglich aktualisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unas 160 monedas, actualizadas a diario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Environ 160 devises, mises à jour chaque jour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "約160通貨、毎日更新。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca de 160 moedas, atualizadas diariamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "约 160 种货币，每日更新。"
          }
        }
      }
    },
    "About 30 ECB currencies. Excludes EGP, AED, and KES.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نحو 30 عملة من البنك المركزي الأوروبي، دون الجنيه المصري والدرهم والشلن الكيني."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rund 30 EZB-Währungen. Ohne EGP, AED und KES."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unas 30 monedas del BCE. No incluye EGP, AED ni KES."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Environ 30 devises de la BCE. Sans EGP, AED ni KES."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "欧州中央銀行（ECB）の約30通貨。EGP・AED・KESは含みません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca de 30 moedas do BCE. Não inclui EGP, AED e KES."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "约 30 种欧洲央行货币，不含 EGP、AED 和 KES。"
          }
        }
      }
    },
    "Anything to write down?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل من شيء لتسجيله؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas einzutragen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Algo que anotar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelque chose à noter ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録することはありますか？"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo para anotar?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有要记录的吗？"
          }
        }
      }
    },
    "Card payment due %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سداد البطاقة مستحق في %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartenzahlung fällig am %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pago de tarjeta: vence el %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paiement de la carte dû le %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードの支払い期日：%@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagamento do cartão vence em %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "信用卡还款日：%@"
          }
        }
      }
    },
    "Cash account: the name says cash.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حساب نقدي: الاسم يدل على ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bargeldkonto: Der Name deutet auf Bargeld hin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta de efectivo: el nombre lo indica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compte espèces : le nom l’indique."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現金口座：名前に「cash」が含まれています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta em dinheiro: o nome indica dinheiro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现金账户：名称中含有“现金”。"
          }
        }
      }
    },
    "Checking account: default for a budget account.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حساب جاري: الافتراضي لحسابات الميزانية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Girokonto: Standard für ein Budgetkonto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta corriente: el valor predeterminado para una cuenta del presupuesto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compte courant : choix par défaut pour un compte budgété."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "普通預金口座：予算内口座の既定値です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta corrente: padrão para contas do orçamento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "活期账户：预算账户的默认类型。"
          }
        }
      }
    },
    "Clear and reconcile your accounts and look over the plan, so %@ starts clean.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قيّد حساباتك وطابِقها وراجع الخطة، ليبدأ %@ نظيفًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Buche und gleiche deine Konten ab und sieh den Plan durch, damit %@ sauber beginnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma y concilia tus cuentas y revisa el plan para empezar %@ en orden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pointez et rapprochez vos comptes et relisez le plan, pour bien commencer %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "口座を確定・照合し、プランを見直して、%@を気持ちよく始めましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compense e concilie suas contas e revise o plano, para %@ começar em ordem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "入账并对账，查看计划，让%@有个干净的开始。"
          }
        }
      }
    },
    "Could not decompress %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر فك ضغط %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ konnte nicht entpackt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo descomprimir %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de décompresser %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を展開できませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível descompactar %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法解压 %@。"
          }
        }
      }
    },
    "Credit card: a payment category is named after this account.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بطاقة ائتمان: يوجد بند سداد باسم هذا الحساب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kreditkarte: Eine Zahlungskategorie trägt den Namen dieses Kontos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarjeta de crédito: hay una categoría de pago con el nombre de esta cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Carte de crédit : une catégorie de remboursement porte le nom de ce compte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クレジットカード：この口座名の支払いカテゴリがあります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartão de crédito: há uma categoria de pagamento com o nome desta conta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "信用卡：有一个以此账户命名的还款类别。"
          }
        }
      }
    },
    "Currency %@ from the name suffix.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العملة %@ من نهاية الاسم."
          }
        },
        "de": {
