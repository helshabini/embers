    "Give this month's money a job: assign what is ready.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امنح مال هذا الشهر مهمة: خصّص المتاح للتوزيع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib dem Geld dieses Monats eine Aufgabe: Verteile, was bereitliegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dale un trabajo al dinero de este mes: asigna lo que está listo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donnez une mission à l'argent de ce mois : allouez ce qui est disponible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今月のお金に役割を与えましょう。割り当て可能額を割り当ててください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê uma função ao dinheiro deste mês: distribua o que está pronto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给本月的钱分配任务：把待分配的钱分配出去。"
          }
        }
      }
    },
