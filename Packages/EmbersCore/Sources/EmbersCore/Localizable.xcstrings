    "Marked closed: its payment category is hidden.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مُعلَّم كمغلق: بند السداد الخاص به مخفي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als geschlossen markiert: Die Zahlungskategorie ist ausgeblendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcada como cerrada: su categoría de pago está oculta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marqué comme clôturé : sa catégorie de remboursement est masquée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解約済み：支払いカテゴリが非表示になっています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcada como encerrada: a categoria de pagamento está oculta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已标记为关闭：其还款类别已隐藏。"
          }
        }
      }
    },
    "Monthly": {
      "localizations": {
