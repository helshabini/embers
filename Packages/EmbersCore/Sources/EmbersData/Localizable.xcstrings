    "Entirely optional spending, just for enjoyment: hobbies, games, eating out, money to spend on a whim.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مصاريف اختيارية تمامًا للمتعة: الهوايات، الألعاب، الخروج للأكل، ومصروف تنفقه كما تشاء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganz freiwillige Ausgaben, nur zum Vergnügen: Hobbys, Spiele, Essen gehen, Geld für spontane Wünsche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gastos totalmente opcionales, solo para disfrutar: aficiones, juegos, comer fuera, dinero para un capricho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des dépenses entièrement facultatives, pour le plaisir : loisirs, jeux, restaurants, argent à dépenser sur un coup de tête."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "楽しみのためだけの、完全に任意の支出：趣味、ゲーム、外食、気ままに使えるお金など。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gastos totalmente opcionais, só por diversão: hobbies, jogos, comer fora, dinheiro para gastar como quiser."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完全可选、只为开心的花销：兴趣爱好、游戏、下馆子，还有随心花的零花钱。"
          }
        }
      }
    },
