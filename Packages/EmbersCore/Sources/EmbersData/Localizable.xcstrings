    "What you pay every month, in much the same amount: rent, bills, groceries, getting around. Fund these first.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما تدفعه كل شهر بمبالغ متقاربة: الإيجار والفواتير والبقالة والمواصلات. موّلها أولًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du jeden Monat in etwa gleicher Höhe zahlst: Miete, Rechnungen, Lebensmittel, Fahrtkosten. Fülle diese zuerst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que pagas cada mes, por un importe parecido: alquiler, facturas, supermercado, transporte. Cúbrelos primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous payez chaque mois, pour un montant à peu près fixe : loyer, factures, courses, transports. À financer en premier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎月ほぼ同じ額を支払うもの：家賃、公共料金、食費、交通費など。まずここに割り当てましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você paga todo mês, em valores parecidos: aluguel, contas, mercado, transporte. Garanta estas primeiro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每月都要付、金额也差不多的开支：房租、账单、买菜、交通。优先给它们分配资金。"
          }
        }
      }
    },
