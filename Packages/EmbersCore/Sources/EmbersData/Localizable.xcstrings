    "This group comes with the app and keeps its name. Hide it and add your own instead.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه المجموعة من التطبيق ويبقى اسمها ثابتًا. أخفِها وأضف مجموعتك الخاصة بدلًا منها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Gruppe gehört zur App und behält ihren Namen. Blende sie aus und füge stattdessen eine eigene hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este grupo viene con la app y conserva su nombre. Ocúltalo y añade uno propio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce groupe est fourni par l’app et garde son nom. Masquez-le et ajoutez plutôt le vôtre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このグループはアプリに組み込まれており、名前は変更できません。非表示にして、独自のグループを追加してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este grupo vem com o app e mantém o nome. Oculte-o e crie o seu no lugar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是 App 自带的分组，名称不可更改。你可以隐藏它，另建自己的分组。"
          }
        }
      }
    },
    "This has %@. Hide it instead — the figures stay.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي هذا على %@. أخفِه بدلًا من ذلك — تبقى الأرقام كما هي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie enthält %@. Blende sie lieber aus – die Zahlen bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiene %@. En su lugar, usa Ocultar: las cifras se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contient %@. Masquez-la plutôt : les montants sont conservés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が含まれています。代わりに非表示にしてください。金額はそのまま残ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto tem %@. Prefira ocultar — os valores continuam."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里包含%@。建议改为隐藏，数据会保留。"
          }
        }
      }
    },
    "This removes both sides of the transfer, here and in %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيحذف هذا طرفي التحويل، هنا وفي %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden beide Seiten der Umbuchung entfernt, hier und in %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina ambos lados de la transferencia, aquí y en %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime les deux côtés du virement, ici et dans %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この振替を、ここと%@の両方から削除します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso apaga os dois lados da transferência, aqui e em %@."
