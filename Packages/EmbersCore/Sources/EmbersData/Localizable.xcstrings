    "Money kept for later rather than spent: an emergency cushion, savings, investments.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أموال تُحفظ للمستقبل بدل أن تُصرف: احتياطي للطوارئ، ادخار، استثمار."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geld für später statt zum Ausgeben: ein Notgroschen, Ersparnisse, Geldanlagen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinero que guardas para después en lugar de gastarlo: un colchón para emergencias, ahorros, inversiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’argent mis de côté plutôt que dépensé : épargne de précaution, économies, placements."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使わずに将来のために取っておくお金：緊急時の備え、貯金、投資など。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinheiro guardado para depois em vez de gasto: reserva de emergência, economias, investimentos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留给将来而不是现在花的钱：应急备用金、储蓄、投资。"
          }
        }
      }
    },
    "Money owed on a schedule outside your credit cards, such as a mortgage or a loan.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ديون تُسدَّد على أقساط خارج بطاقات الائتمان، مثل التمويل العقاري أو القروض."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Planmäßig zu tilgende Schulden außerhalb deiner Kreditkarten, etwa eine Baufinanzierung oder ein Kredit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deudas con pagos fijos aparte de tus tarjetas de crédito, como una hipoteca o un préstamo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dettes à échéances hors cartes de crédit, comme un prêt immobilier ou un crédit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "住宅ローンや各種ローンなど、クレジットカード以外で計画的に返済するもの。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dívidas pagas em parcelas fora dos cartões de crédito, como um financiamento ou um empréstimo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "信用卡以外按期偿还的欠款，例如房贷或其他贷款。"
          }
        }
      }
    },
